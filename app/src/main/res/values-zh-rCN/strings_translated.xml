    <string name="setup_check_screening_ok">来电筛选已启用</string>
    <string name="setup_check_screening_ok_text">在手机响铃之前，Android 会就每个来电询问 CallGuard。</string>
    <string name="setup_check_screening_dialer_text">CallGuard 是默认电话应用，会在手机响铃前检查每个来电。</string>
    <string name="setup_check_screening_missing">未允许来电筛选</string>
    <string name="setup_check_screening_missing_text">CallGuard 不是您的来电筛选应用，因此 Android 不会就来电询问它，骚扰电话也无法在响铃前被拒绝。点按“允许”并选择 CallGuard。</string>
    <string name="setup_check_screening_monitoring">来电监控已启用</string>
    <string name="setup_check_screening_monitoring_text">监控服务在后台监视来电。</string>
    <string name="setup_check_screening_legacy">来电在响铃时检查</string>
    <string name="setup_check_screening_legacy_text">在此 Android 版本上，CallGuard 对响铃信号作出反应，而该信号可能来得较晚。为了更可靠地拦截，请将 CallGuard 设为默认电话应用，或在设置中开启监控服务。</string>
    <string name="setup_check_permissions_ok">已授予权限</string>
    <string name="setup_check_permissions_ok_text">CallGuard 可以看到来电和通话记录。</string>
    <string name="setup_check_permissions_phone">缺少电话权限</string>
    <string name="setup_check_permissions_phone_text">没有电话状态和通话记录的访问权限，CallGuard 无法知道是谁在来电。</string>
    <string name="setup_check_permissions_call_control">缺少挂断电话的权限</string>
    <string name="setup_check_permissions_call_control_text">没有来电筛选时，CallGuard 必须自行挂断不需要的来电，而 Android 尚未允许这样做。</string>
    <string name="setup_check_permissions_contacts">缺少联系人权限</string>
    <string name="setup_check_permissions_contacts_text">“使用联系人”已开启，但 CallGuard 无法读取您的联系人，因此联系人会被视为未知号码。</string>
    <string name="setup_check_blocking_rating">骚扰号码会被拦截</string>
    <string name="setup_check_blocking_rating_text">来自数据库中负面评分号码的来电会被拒绝。</string>
    <string name="setup_check_blocking_no_rating">数据库中的骚扰号码未被拦截</string>
    <string name="setup_check_blocking_no_rating_text">只拦截黑名单（或隐藏号码）。数据库中被标记为骚扰的号码仍会响铃。请在设置中开启“根据评分拦截”。</string>
    <string name="setup_check_blocking_empty_blacklist">没有任何拦截</string>
    <string name="setup_check_blocking_empty_blacklist_text">按评分拦截已关闭，且黑名单为空，因此所有来电都会响铃。请在设置中开启“根据评分拦截”，或将号码加入黑名单。</string>
    <string name="setup_check_blocking_off">拦截已关闭</string>
    <string name="setup_check_blocking_off_text">所有拦截选项都已关闭：来电只会被识别，不会被拒绝。请在设置中开启“根据评分拦截”。</string>
    <string name="setup_check_notifications_ok">通知已开启</string>
    <string name="setup_check_notifications_ok_text">您可以看到谁在来电以及哪些来电被拦截。</string>
    <string name="setup_check_notifications_permission">未允许通知</string>
    <string name="setup_check_notifications_disabled">通知已关闭</string>
    <string name="setup_check_notifications_disabled_text">Android 不允许 CallGuard 显示通知。拦截仍然有效，但您既看不到来电者信息也看不到被拦截的来电，看起来好像什么都没发生。</string>
    <string name="setup_check_notifications_channels">部分来电通知已关闭</string>
    <string name="setup_check_notifications_channels_text">系统设置中关闭了来电或已拦截来电的通知类别，因此这些来电会静默发生。</string>
    <string name="setup_check_notifications_setting_off">来电者信息已关闭</string>
    <string name="setup_check_notifications_setting_off_text">设置中的“来电通知”已关闭。来电仍会被检查，但您看不到是谁在来电。</string>
    <string name="setup_check_battery_exempt">CallGuard 的电池优化已关闭</string>
    <string name="setup_check_battery_exempt_text">监控服务可以在后台持续运行。</string>
    <string name="setup_check_battery_optimized">电池优化已开启</string>
    <string name="setup_check_battery_optimized_text">监控服务已开启。部分手机会为省电而停止后台服务；如果漏接来电，请将 CallGuard 排除在电池优化之外。</string>
    <string name="setup_check_contacts">联系人永远不会被拦截</string>
    <string name="setup_check_contacts_text">“使用联系人”已开启：保存在联系人中的号码总是放行，不会有任何提示。因此来自联系人的测试来电不会显示任何内容，这是正常的。</string>
