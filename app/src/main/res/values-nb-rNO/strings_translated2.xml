        <item quantity="other">%d markeringer sendt til PhoneBlock</item>
    </plurals>
    <plurals name="pbreport_pending_count">
        <item quantity="one">%d venter på å bli sendt</item>
        <item quantity="other">%d venter på å bli sendt</item>
