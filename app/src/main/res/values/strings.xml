    <string name="setup_check_screening_ok">Call screening is active</string>
    <string name="setup_check_screening_ok_text">Android asks CallGuard about every incoming call before the phone rings.</string>
    <string name="setup_check_screening_dialer_text">CallGuard is the default phone app and checks every incoming call before the phone rings.</string>
    <string name="setup_check_screening_missing">Call screening is not allowed</string>
    <string name="setup_check_screening_missing_text">CallGuard is not your call screening app, so Android does not ask it about incoming calls and spam cannot be rejected before it rings. Tap “Allow” and choose CallGuard.</string>
    <string name="setup_check_screening_monitoring">Call monitoring is active</string>
    <string name="setup_check_screening_monitoring_text">The monitoring service watches incoming calls in the background.</string>
    <string name="setup_check_screening_legacy">Calls are checked while ringing</string>
    <string name="setup_check_screening_legacy_text">On this Android version CallGuard reacts to the ringing signal, which may come late. For more reliable blocking, make CallGuard the default phone app or turn on the monitoring service in the settings.</string>
    <string name="setup_check_permissions_ok">Permissions granted</string>
    <string name="setup_check_permissions_ok_text">CallGuard can see incoming calls and the call log.</string>
    <string name="setup_check_permissions_phone">Phone permissions missing</string>
    <string name="setup_check_permissions_phone_text">Without access to the phone state and the call log CallGuard does not know who is calling.</string>
    <string name="setup_check_permissions_call_control">Permission to end calls missing</string>
    <string name="setup_check_permissions_call_control_text">Without call screening CallGuard has to hang up unwanted calls itself, and Android does not allow that yet.</string>
    <string name="setup_check_permissions_contacts">Contacts permission missing</string>
    <string name="setup_check_permissions_contacts_text">“Use contacts” is on, but CallGuard cannot read your contacts, so your contacts are treated like unknown numbers.</string>
    <string name="setup_check_blocking_rating">Spam numbers are blocked</string>
    <string name="setup_check_blocking_rating_text">Calls from numbers rated negative in the databases are rejected.</string>
    <string name="setup_check_blocking_no_rating">Spam from the databases is not blocked</string>
    <string name="setup_check_blocking_no_rating_text">Only the blacklist (or hidden numbers) is blocked. Numbers flagged as spam in the databases still ring. Turn on “Block based on rating” in the settings.</string>
    <string name="setup_check_blocking_empty_blacklist">Nothing is blocked</string>
    <string name="setup_check_blocking_empty_blacklist_text">Blocking by rating is off and the blacklist is empty, so every call rings. Turn on “Block based on rating” in the settings or add numbers to the blacklist.</string>
    <string name="setup_check_blocking_off">Blocking is off</string>
    <string name="setup_check_blocking_off_text">All blocking options are off: calls are only identified, never rejected. Turn on “Block based on rating” in the settings.</string>
    <string name="setup_check_notifications_ok">Notifications are on</string>
    <string name="setup_check_notifications_ok_text">You see who is calling and which calls were blocked.</string>
    <string name="setup_check_notifications_permission">Notifications are not allowed</string>
    <string name="setup_check_notifications_disabled">Notifications are turned off</string>
    <string name="setup_check_notifications_disabled_text">Android does not let CallGuard show notifications. Blocking still works, but you see neither caller info nor blocked calls, so it looks as if nothing happens.</string>
    <string name="setup_check_notifications_channels">Some call notifications are turned off</string>
    <string name="setup_check_notifications_channels_text">Notification categories for incoming or blocked calls are turned off in the system settings, so these calls happen silently.</string>
    <string name="setup_check_notifications_setting_off">Caller info is off</string>
    <string name="setup_check_notifications_setting_off_text">“Incoming call notifications” is off in the settings. Calls are still checked, but you do not see who is calling.</string>
    <string name="setup_check_battery_exempt">Battery optimization is off for CallGuard</string>
    <string name="setup_check_battery_exempt_text">The monitoring service can keep running in the background.</string>
    <string name="setup_check_battery_optimized">Battery optimization is on</string>
    <string name="setup_check_battery_optimized_text">The monitoring service is on. Some phones stop background services to save battery; if calls are missed, exclude CallGuard from battery optimization.</string>
    <string name="setup_check_contacts">Contacts are never blocked</string>
    <string name="setup_check_contacts_text">“Use contacts” is on: numbers saved in your contacts are always let through, without any notice. A test call from a contact therefore shows nothing; that is expected.</string>
    <string name="setup_check_sources_none">No database is enabled</string>
    <string name="setup_check_sources_none_text">All number databases are turned off, so no number can be recognized as spam.</string>
    <string name="setup_check_source_ok">Up to date, updated %s</string>
    <string name="setup_check_source_ready">Ready</string>
    <string name="setup_check_source_disabled">Turned off: numbers are not checked against this source.</string>
    <string name="setup_check_source_not_configured">Not set up yet (e.g. the API key is missing). Open the details to set it up.</string>
