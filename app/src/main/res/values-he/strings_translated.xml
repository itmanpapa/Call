    <string name="setup_check_screening_ok_text">Android שואל את CallGuard על כל שיחה נכנסת לפני שהטלפון מצלצל.</string>
    <string name="setup_check_screening_dialer_text">CallGuard היא אפליקציית הטלפון המוגדרת כברירת מחדל ובודקת כל שיחה נכנסת לפני שהטלפון מצלצל.</string>
    <string name="setup_check_screening_missing">סינון השיחות אינו מותר</string>
    <string name="setup_check_screening_missing_text">CallGuard אינה אפליקציית סינון השיחות שלך, ולכן Android לא שואל אותה על שיחות נכנסות ואי אפשר לדחות ספאם לפני הצלצול. יש להקיש על „התרה” ולבחור ב־CallGuard.</string>
    <string name="setup_check_screening_monitoring">ניטור השיחות פעיל</string>
    <string name="setup_check_screening_monitoring_text">שירות הניטור עוקב אחר שיחות נכנסות ברקע.</string>
    <string name="setup_check_screening_legacy">השיחות נבדקות בזמן הצלצול</string>
    <string name="setup_check_screening_legacy_text">בגרסת Android זו CallGuard מגיבה לאות הצלצול, שעלול להגיע באיחור. לחסימה אמינה יותר, יש להגדיר את CallGuard כאפליקציית הטלפון המוגדרת כברירת מחדל או להפעיל את שירות הניטור בהגדרות.</string>
    <string name="setup_check_permissions_ok">ההרשאות ניתנו</string>
    <string name="setup_check_permissions_ok_text">CallGuard יכולה לראות שיחות נכנסות ואת יומן השיחות.</string>
    <string name="setup_check_permissions_phone">חסרות הרשאות טלפון</string>
    <string name="setup_check_permissions_phone_text">ללא גישה למצב הטלפון וליומן השיחות CallGuard לא יודעת מי מתקשר.</string>
    <string name="setup_check_permissions_call_control">חסרה הרשאה לסיום שיחות</string>
    <string name="setup_check_permissions_call_control_text">ללא סינון שיחות CallGuard צריכה לנתק בעצמה שיחות לא רצויות, ו־Android עדיין לא מתיר זאת.</string>
    <string name="setup_check_permissions_contacts">חסרה הרשאת אנשי קשר</string>
    <string name="setup_check_permissions_contacts_text">„השתמש באנשי קשר” מופעל, אבל CallGuard לא יכולה לקרוא את אנשי הקשר שלך, ולכן הם מטופלים כמספרים לא מוכרים.</string>
    <string name="setup_check_blocking_rating">מספרי ספאם נחסמים</string>
    <string name="setup_check_blocking_rating_text">שיחות ממספרים עם דירוג שלילי במסדי הנתונים נדחות.</string>
    <string name="setup_check_blocking_no_rating">ספאם ממסדי הנתונים אינו נחסם</string>
    <string name="setup_check_blocking_no_rating_text">רק הרשימה השחורה (או מספרים חסויים) נחסמת. מספרים שסומנו כספאם במסדי הנתונים עדיין מצלצלים. יש להפעיל את „חסום בהתבסס על דירוג” בהגדרות.</string>
    <string name="setup_check_blocking_empty_blacklist">שום דבר לא נחסם</string>
    <string name="setup_check_blocking_empty_blacklist_text">החסימה לפי דירוג כבויה והרשימה השחורה ריקה, ולכן כל שיחה מצלצלת. יש להפעיל את „חסום בהתבסס על דירוג” בהגדרות או להוסיף מספרים לרשימה השחורה.</string>
    <string name="setup_check_blocking_off">החסימה כבויה</string>
    <string name="setup_check_blocking_off_text">כל אפשרויות החסימה כבויות: השיחות רק מזוהות, אף פעם לא נדחות. יש להפעיל את „חסום בהתבסס על דירוג” בהגדרות.</string>
    <string name="setup_check_notifications_ok">ההתראות מופעלות</string>
